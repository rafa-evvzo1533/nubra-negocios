DATABASE_URL="postgresql://nubra_web:YOUR_RUNTIME_PASSWORD@localhost:5432/nubra_negocios"
# Deployment/migration process only. Never inject this into a hosted web runtime.
MIGRATION_DATABASE_URL="postgresql://postgres:YOUR_MIGRATION_PASSWORD@localhost:5432/nubra_negocios"
SESSION_SECRET="replace-with-a-long-random-secret"
FILE_SIGNING_SECRET="replace-with-at-least-32-random-characters"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
ADMIN_USERNAME="replace-with-admin-username"

# Registration, verification and recovery email. Configure your SMTP provider.
MAIL_ENABLED=false
APP_URL="http://localhost:3000"
MAIL_FROM="Nubra Negocios <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
# For isolated local SMTP tests only. Never use with a remote host.
MAIL_ALLOW_LOCAL_SMTP=false

# Mercado Pago Argentina. Disabled until account credentials and plan prices are configured.
BILLING_ENABLED=false
MP_MODE=sandbox
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
MP_COLLECTOR_ID=""
# HTTPS public APP_URL is required for provider notifications in a deployed environment.
# Webhook URL: /api/billing/mercadopago/webhook
