# /etc/nubra-negocios/runtime.env — root:root, mode 0600.
# The systemd unit injects these values into the unprivileged process.
DEPLOYMENT_TARGET=vps
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
APP_URL=https://YOUR_PUBLIC_HOSTNAME
DATABASE_URL=postgresql://nubra_web:YOUR_RUNTIME_PASSWORD@127.0.0.1:55432/nubra_negocios
DATABASE_POOL_MAX=5
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
FILE_SIGNING_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
MAIL_ENABLED=false
MAIL_ALLOW_LOCAL_SMTP=false
MAIL_FROM="Nubra Negocios <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
BILLING_ENABLED=false
MP_MODE=sandbox
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
