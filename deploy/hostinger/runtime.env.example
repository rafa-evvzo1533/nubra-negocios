# Import these values into the Node.js app in hPanel. No migration or bootstrap credentials.
DEPLOYMENT_TARGET=hostinger
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000
APP_URL=https://negocios.example.com
DATABASE_URL=postgresql://nubra_web:YOUR_RUNTIME_PASSWORD@YOUR_POSTGRES_HOST:5432/nubra_negocios?sslmode=verify-full
DATABASE_POOL_MAX=5
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
FILE_SIGNING_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
MAIL_ENABLED=false
MAIL_ALLOW_LOCAL_SMTP=false
MAIL_FROM=Nubra Negocios <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
BILLING_ENABLED=false
MP_MODE=sandbox
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
